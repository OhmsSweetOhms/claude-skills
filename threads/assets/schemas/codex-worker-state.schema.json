{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude.local/threads/codex-worker-state.schema.json",
  "title": "Foreground Codex worker lifecycle state (v2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "worker_run_id",
    "plan_id",
    "thread_id",
    "state",
    "source_head",
    "launch",
    "process",
    "mailbox",
    "session_id",
    "reason",
    "events",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "2" },
    "worker_run_id": { "type": "string", "format": "uuid" },
    "plan_id": { "type": "string", "pattern": "^plan-[0-9a-z]" },
    "thread_id": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["starting", "running", "blocked", "completed", "failed", "exited"]
    },
    "source_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_at",
        "worktree",
        "branch",
        "model",
        "reasoning_effort",
        "auto_compact_token_limit"
      ],
      "properties": {
        "requested_at": { "type": "string", "format": "date-time" },
        "worktree": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "reasoning_effort": {
          "enum": ["none", "low", "medium", "high", "xhigh", "max"]
        },
        "auto_compact_token_limit": { "type": "integer", "minimum": 1 }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "launcher_pid",
        "launcher_identity",
        "worker_pid",
        "worker_identity",
        "started_at",
        "exited_at",
        "exit_code"
      ],
      "properties": {
        "state": { "enum": ["starting", "running", "exited"] },
        "launcher_pid": { "type": "integer", "minimum": 1 },
        "launcher_identity": { "$ref": "#/definitions/processIdentity" },
        "worker_pid": { "type": ["integer", "null"], "minimum": 1 },
        "worker_identity": {
          "oneOf": [
            { "$ref": "#/definitions/processIdentity" },
            { "type": "null" }
          ]
        },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "exited_at": { "type": ["string", "null"], "format": "date-time" },
        "exit_code": { "type": ["integer", "null"] }
      }
    },
    "mailbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "prompt",
        "handback_json",
        "handback_markdown",
        "questions",
        "progress"
      ],
      "properties": {
        "state": { "const": "worker-state.json" },
        "prompt": { "const": "prompt.md" },
        "handback_json": { "const": "handback.json" },
        "handback_markdown": { "const": "handback.md" },
        "questions": { "const": "questions" },
        "progress": { "const": "progress.json" }
      }
    },
    "session_id": { "type": ["string", "null"] },
    "reason": { "type": ["string", "null"] },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "at", "state"],
        "properties": {
          "event": {
            "enum": [
              "WORKER_STARTING",
              "WORKER_LAUNCHED",
              "WORKER_SESSION_BOUND",
              "WORKER_RUNNING",
              "WORKER_BLOCKED",
              "WORKER_COMPLETED",
              "WORKER_FAILED",
              "WORKER_EXITED",
              "WORKER_PROCESS_EXITED",
              "WORKER_LAUNCH_FAILED"
            ]
          },
          "at": { "type": "string", "format": "date-time" },
          "state": {
            "enum": ["starting", "running", "blocked", "completed", "failed", "exited"]
          },
          "detail": { "type": "string" }
        }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "boot_id", "start_ticks"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "boot_id": { "type": "string", "format": "uuid" },
        "start_ticks": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
